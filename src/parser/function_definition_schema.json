{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Function Definitions",
    "description": "Schema for defining functions, their parameters, and return types.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string"
            },
            "description": {
                "type": "string"
            },
            "parameters": {
                "type": "object",
                "additionalProperties": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "string",
                                "number"
                            ]
                        }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                }
            },
            "returns": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "string",
                            "number"
                        ]
                    }
                },
                "required": ["type"],
                "additionalProperties": false
            }
        },
        "required": [
            "name",
            "description",
            "parameters",
            "returns"
        ],
        "additionalProperties": false
    }
}
